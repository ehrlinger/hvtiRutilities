30         
31         %macro uni(scenario=, fixture=, weight=0, vardef=DF, mu0=0, class=0,
32                    ttest=1, ranktests=1);
33           %local _rc vars hdr;
34         
35           proc datasets lib=work nolist nowarn;
36             delete fx o cols;
37           quit;
38         
39           filename _old "&root/out/&scenario..csv";
40           %if %sysfunc(fexist(_old)) %then %do;
41             %let _rc = %sysfunc(fdelete(_old));
42             %if &_rc ne 0 %then %put ERROR: could not delete stale &scenario..csv.;
43           %end;
44           filename _old clear;
45         
46           data work.fx;
47             infile "&root/fixtures/&fixture..csv" dsd firstobs=2 truncover;
48             input id g :$8. x w;
49           run;
                                                           The SAS System

50         
51           proc univariate data=work.fx noprint mu0=&mu0 vardef=&vardef
52             %if &ranktests = 1 %then normal;
53             ;
54             %if &class = 1 %then %do;
55               class g;
56             %end;
57             var x;
58             %if &weight = 1 %then %do;
59               weight w;
60             %end;
61             output out=work.o
62               n=n nobs=nobs nmiss=nmiss sum=sum mean=mean std=std var=var cv=cv
63               stdmean=stdmean uss=uss css=css skewness=skewness kurtosis=kurtosis
64               sumwgt=sumwgt range=range qrange=qrange mode=mode min=min max=max
65               median=median q1=q1 q3=q3 p1=p1 p5=p5 p10=p10 p90=p90 p95=p95 p99=p99
66               %if &ttest = 1 %then %do;
67                 t=t probt=probt
68               %end;
69               %if &ranktests = 1 %then %do;
70                 msign=msign probm=probm signrank=signrank probs=probs
71                 normal=normal probn=probn
72               %end;
73               pctlpts=0 2.5 16 50 84 97.5 100 pctlpre=pp_;
74           run;
75         
76           %if &syserr > 4 or not %sysfunc(exist(work.o)) %then %do;
77             %put WARNING: scenario &scenario produced no output (syserr=&syserr).;
78             %goto done;
79           %end;
80         
81           proc contents data=work.o out=work.cols(keep=name varnum) noprint;
82           run;
83         
84           proc sql noprint;
85             select name into :vars separated by ' '
86               from work.cols order by varnum;
87             select lowcase(name) into :hdr separated by ','
88               from work.cols order by varnum;
89           quit;
90         
91           data _null_;
92             set work.o;
93             file "&root/out/&scenario..csv" dsd lrecl=32767;
94             format _numeric_ best32.;
95             if _n_ = 1 then put "&hdr";
96             put (&vars) (:);
97           run;
98         
99           %done:
100        %mend uni;
101        
102        /* One %uni call per row of scenarios.csv, so the SAS runs cannot drift from
103           the manifest that make_fixtures.R writes and check_oracle.R reads. */
104        data _null_;
105          infile "&root/scenarios.csv" dsd firstobs=2 truncover;
106          length scenario fixture vardef $32;
107          input scenario $ fixture $ weight vardef $ mu0 class ttest ranktests
                                                           The SAS System

108                optional;
109          call execute(cats('%nrstr(%uni)(scenario=', scenario,
110                            ', fixture=', fixture, ', weight=', weight,
111                            ', vardef=', vardef, ', mu0=', mu0,
112                            ', class=', class, ', ttest=', ttest,
113                            ', ranktests=', ranktests, ')'));
114        run;

